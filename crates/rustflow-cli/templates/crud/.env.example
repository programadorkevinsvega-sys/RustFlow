RUSTFLOW_ENV=development
RUSTFLOW_HOST=127.0.0.1
RUSTFLOW_PORT=3000
RUSTFLOW_DATABASE_URL=sqlite://rustflow.db?mode=rwc
RUSTFLOW_DATABASE_MAX_CONNECTIONS=10
RUSTFLOW_DATABASE_MIN_CONNECTIONS=0
RUSTFLOW_DATABASE_ACQUIRE_TIMEOUT_SECS=10

# Local demo only. Replace these values; never commit .env.
RUSTFLOW_DEMO_USER=admin
RUSTFLOW_DEMO_PASSWORD=replace-this-local-demo-password
RUSTFLOW_CSRF_KEY=replace-this-with-a-random-secret-of-at-least-32-bytes
